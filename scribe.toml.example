# Copy to scribe.toml to override defaults. Env vars (SCRIBE_*) win over this.

# data_dir = "data"          # intake/, archive/, work/, out/ live here
# database_url = "postgresql+psycopg://scribe:scribe@localhost:5433/scribe"

# stale_after_s = 120        # heartbeat age before a job is reclaimed
# scan_interval_s = 10       # how often the intake folder is scanned
# min_stable_age_s = 5       # a file must be untouched this long to be picked up

[asr]
backend = "mlx"              # "mlx" on Apple Silicon, "onnx" in containers
# mlx_model = "mlx-community/parakeet-tdt-0.6b-v3"

[diarize]
device = "auto"              # auto | cpu | mps | cuda — benchmark, don't assume
# num_speakers = 3           # pin it when known; improves the split noticeably
# min_speakers = 2
# max_speakers = 6

[merge]
# Tune these against your own audio; the defaults suit meeting recordings.
nearest_window_s = 0.25      # how far a word reaches for a nearby speaker
min_segment_s = 0.12         # ignore diarization segments too short to own a word
smooth_max_words = 5         # absorb speaker runs this short...
smooth_max_duration_s = 0.4  # ...but only if also this brief
turn_gap_s = 1.5             # silence that starts a new turn
turn_max_duration_s = 60.0   # past this, split at a sentence end
